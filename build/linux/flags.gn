# BrowseCraft's Linux GN arguments, after third_party/ungoogled-chromium/flags.gn. From
# ungoogled-chromium-portablelinux flags.linux.gn (156.0.8078.79-1), with BrowseCraft's
# developer-build settings (no official/PGO/ThinLTO build: hours shorter, and mold is not in
# the source tarball).
is_official_build=false
chrome_pgo_phase=0
use_thin_lto=false
use_mold=false
symbol_level=0
disable_fieldtrial_testing_config=true
blink_enable_generated_code_formatting=false
blink_symbol_level=0
ffmpeg_branding="Chrome"
proprietary_codecs=true
fatal_linker_warnings=false
rtc_use_pipewire=true
is_clang=true
is_debug=false
dcheck_always_on=false
use_kerberos=false
use_sysroot=true
use_vaapi=true
use_system_libffi=false
target_cpu="x64"
v8_target_cpu="x64"
