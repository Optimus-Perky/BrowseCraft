{
 "version": "0.8.261013.1",
 "date": "2026-10-13",
 "chromium": "155.0.8059.39",
 "new": [
  "The first numbered BrowseCraft release: Chromium without Google, signing in to your own BrowseCraft server instead of a Google or Microsoft account.",
  "Sync to your own server: bookmarks, passwords, history, open tabs, extensions and settings.",
  "Sign in with your Windows account on a domain PC, or with a user name and password.",
  "Your profile takes its name from the directory, and your profile photo follows you to every PC.",
  "Install extensions from the Chrome Web Store.",
  "An organisation extension store on your server, set by Group Policy: approve extensions once, offer or install them per user, group or PC, and search the Web Store from it.",
  "Bookmarks: right-click a folder to sort it by name, with its subfolders.",
  "A Windows installer, registered as a browser; Widevine (Netflix, Spotify) copied from the PC's own Edge.",
  "BrowseCraft keeps its own profile folder, so it never mixes with another Chromium on the same PC.",
  "Settings > About shows BrowseCraft's own version as well as Chromium's."
 ],
 "fixed": [
  "Dropping a bookmark folder into itself no longer hangs or crashes the bookmark manager.",
  "Extensions work on every other site of a server that also runs the extension store."
 ],
