+// BrowseCraft: sorts `folder` by name, then every folder inside it.
+static void BrowseCraftSortFolderAndSubfolders(
+    bookmarks::BookmarkModel* model,
+    const BookmarkNode* folder) {
+  model->SortChildren(folder);
+  for (const auto& child : folder->children()) {
+    if (child->is_folder()) {
+      BrowseCraftSortFolderAndSubfolders(model, child.get());
+    }
+  }
+}
